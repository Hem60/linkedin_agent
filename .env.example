# Copy to .env and fill in. NEVER commit .env.
# Generate the two secrets with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# --- Required to boot ---------------------------------------------------
DATABASE_URL=postgresql+psycopg://user:password@host:5432/dbname
SESSION_SECRET=
ENCRYPTION_KEY=

# --- LinkedIn (from the developer app's Auth tab) -----------------------
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_API_VERSION=202609
APP_URL=http://localhost:8000

# --- Models (phases 4-5) ------------------------------------------------
GEMINI_API_KEY=
GROQ_API_KEY=

# --- Images (phase 7) ---------------------------------------------------
# Two sources. Generation is the primary one; the Pexels search is what the
# page falls back to once the day's free Neurons are gone.
#
# Cloudflare Workers AI: account ID is the hex string in the dashboard URL,
# and the token needs Workers AI Read and Edit. lucid-origin costs about 1,431
# Neurons per 1024x576 image against a free 10,000 a day -- roughly seven.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Swappable without a redeploy. flux-1-schnell is cheaper but cannot render
# writing and rejects width/height.
IMAGE_MODEL=@cf/leonardo/lucid-origin
# Tried when the first will not fit in what is left of the day's Neurons. The
# allowance is account-wide, so this does not survive it reaching zero -- but
# lucid-origin is ~1,431 Neurons an image and this is ~59, so the tail of the
# budget is still worth a couple of dozen pictures.
IMAGE_FALLBACK_MODEL=@cf/black-forest-labs/flux-2-klein-4b

PEXELS_API_KEY=

# --- Storage (phase 7) --------------------------------------------------
STORAGE_URL=
STORAGE_KEY=
STORAGE_BUCKET=post-images

# --- Email (phase 11) ---------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=

# --- Observability ------------------------------------------------------
SENTRY_DSN=

# --- Behaviour ----------------------------------------------------------
DRY_RUN=true
RUN_SCHEDULER=true
# Drafts generated per person per day, counted from their own midnight.
# 0 turns it off -- reasonable on a private deploy, where the only quota at
# risk is your own. It is consumed before the model request, so deleting a
# post does not give the allowance back.
DAILY_POST_LIMIT=3
DAILY_REWRITE_LIMIT=10
GEMINI_COOLDOWN_MINUTES=30
ADMIN_EMAILS=

# Model ids (override if a newer flash model ships)
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GROQ_MODEL=openai/gpt-oss-120b
